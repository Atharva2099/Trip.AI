{
  "name": "tripai",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://Atharva2099.github.io/Trip.AI",
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.4.20",
    "date-fns": "^2.30.0",
    "leaflet": "^1.9.4",
    "leaflet-routing-machine": "^3.2.12",
    "lucide-react": "^0.263.1",
    "postcss": "^8.4.49",
    "react": "^18.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.17",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:react": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "npm run build && wrangler deploy",
    "deploy:worker": "cd worker && wrangler deploy --env production",
    "deploy:frontend": "npm run build && gh-pages -d build",
    "db:migrate:remote": "cd worker && for f in migrations/*.sql; do wrangler d1 execute tripai-database --remote --config=./wrangler.toml --file=./$f; done",
    "db:reset:local": "cd worker && wrangler d1 execute tripai-database --local --config=./wrangler.toml --command=\"DELETE FROM itineraries; DELETE FROM bookmarks; DELETE FROM sessions; DELETE FROM expenses;\"",
    "preview": "npm run build && wrangler dev"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.7",
    "wrangler": "^4.85.0"
  }
}
